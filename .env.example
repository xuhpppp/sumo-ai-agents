# Copy this file to .env and fill in real values. .env is gitignored -- never
# commit real secrets (see IMPLEMENTATION_PLAN.md section 12.3).

# Anthropic/OpenAI API key for the LLM agents (STEPS.md Step 10+). Not needed
# until Phase 2.
OPENAI_API_KEY=

# Password for the local/dev PostgreSQL container (docker/docker-compose.yml).
# Any value works for local dev -- it is not a production secret.
DB_PASSWORD=

# SQLAlchemy connection URL used by Alembic (migrations/env.py), obs/db.py,
# and Store. The same URL works for both the sync engine (Alembic) and the
# async engine (Store) -- psycopg 3 supports both under this one dialect
# name. When the Postgres container's port is published to the host (see
# docker/docker-compose.yml), connect via localhost:
#   DATABASE_URL=postgresql+psycopg://postgres:<DB_PASSWORD>@localhost:5432/sumo
DATABASE_URL=
