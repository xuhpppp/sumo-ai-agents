<?xml version="1.0" encoding="UTF-8"?>
<!--
  grid_4x4 — POC baseline network (see IMPLEMENTATION_PLAN.md §2, §4; STEPS.md Step 3).

  4x4 SUMO grid, 200m edge length, 2 lanes/direction, 12 signalized junctions
  (the 4 corners are unsignalized network boundary nodes). Traffic demand:
  4500 veh/h over 3600s, generated by randomTrips.py with seed=42 (see
  net.xml / trips.xml generation commands in STEPS.md Step 3).

  The seed option is intentionally NOT hardcoded here - it is passed at run
  time (via SumoConnection.start(seed=...) or the sumo CLI seed flag) so the
  comparison harness (STEPS.md Step 9) can run the same scenario across
  multiple seeds.

  device.rerouting.probability=1.0 equips every vehicle with a rerouting
  device up front, so VMS / route-advisory actions (STEPS.md Step 19) can
  actually change a vehicle's path later without re-touching this config.
-->
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="net.xml"/>
        <route-files value="trips.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1"/>
    </time>

    <processing>
        <device.rerouting.probability value="1.0"/>
    </processing>

</sumoConfiguration>
